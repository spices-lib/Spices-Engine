/**
* @file Shader.BasePassRenderer.Mesh.SkyBox.mesh.
* @brief This Shader Defines BasePass Renderer Mesh SubPass SkyBox Mesh Shader Behaver.
* @author Spices.
*/

/************************************Pre Compile*******************************************/

#version 460
#extension GL_EXT_mesh_shader                 : require   /* @brief Declear this as mesh shader. */
#extension GL_GOOGLE_include_directive        : enable    /* @brief Enable include feature.      */
#extension GL_EXT_control_flow_attributes     : require   /* @brief Enable flow butter control.  */

#include "Header/ShaderPreRendererLayout.glsl"
#include "Header/ShaderMeshDescLayout.glsl"

/*****************************************************************************************/

/*************************************Mesh Input******************************************/

/**
* @brief 128(Local Work Groups Count) ~ 126(Nvidia Recommended Meshlet Primitives) ~ 124(MeshOptimizer Required Meshlet Primitives)
* But subgroup size only support 32 in nvidia / 64 in amd.
* Thereforce use iter to reach all primitives in meshlet.
*/
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

/**
* @brief task padload receive from task shader.
*/
taskPayloadSharedEXT struct Task 
{
    uint meshletIndex[SUBGROUP_SIZE];    /* @brief mesh shader hanled meshlet id. */
} 
task;    

/*****************************************************************************************/

/*************************************Mesh Output*****************************************/

/**
* @brief Output triangles meshlet per workgroup.
*/
layout(triangles, max_vertices = MESHLET_NVERTICES, max_primitives = MESHLET_NPRIMITIVES) out;

/**
* @brief Output data to fragment shader.
*/
layout(location = 0) out flat uint primitiveId[];            /* @brief Primitive ID.            */
layout(location = 1) out flat uint meshletId[];              /* @brief Meshlet ID.              */

layout(location = 2) out struct MeshOut 
{
    vec3 localPosition;
    vec3 worldPosition;
} 
meshOut[];

/*****************************************************************************************/

/*********************************Push Constant*******************************************/

/**
* @brief push constant.
*/
layout(push_constant) uniform Push 
{
    uint64_t descAddress;
} 
push;

/*****************************************************************************************/

/**********************************Shader Entry*******************************************/

void main()
{
    const uint id = task.meshletIndex[gl_WorkGroupID.x];
    ExplainMeshDesciption(push.descAddress);

    /**
    * @brief Get current handle meshlet and primitiveIndex.
    */
    const Meshlet meshlet        = meshlets.i[id];
    const uint localId           = gl_LocalInvocationIndex;
    const uint primitiveIndex    = meshlet.primitiveOffset + localId;
        
    /**
    * @brief Return if sumbit all primitives.
    */
    if(localId >= meshlet.nPrimitives) return;

    /**
    * @brief Get used mesh descriptions.
    */
    const mat4 mvp               = view.projection * view.view * model;
    const Vertex[3] vertices     = GetVerticesUsingPrimitive(primitiveIndex);
    const uvec3 primLocation     = primitiveLocations.i[primitiveIndex] - ivec3(meshlet.vertexOffset);
    const uint indicesList[3]    = { primLocation.x, primLocation.y, primLocation.z };
        
    /**
    * @brief Submit Vertex.
    */
    [[unroll]]
    for(int it = 0; it < 3; it++)
    {
        const Vertex vertex = vertices[it];
        const uint index = indicesList[it];
    
        gl_MeshVerticesEXT[index].gl_Position = mvp * vec4(vertex.position, 1.0f);
            
        primitiveId[index]      = primitiveIndex;
        meshletId[index]        = id;

        meshOut[index].localPosition  = vertex.position;
        meshOut[index].worldPosition  = vec3(model * vec4(vertex.position, 1.0f));
    }

    /**
    * @brief Submit Primitive.
    */
    gl_PrimitiveTriangleIndicesEXT[localId] =  primLocation;
    SetMeshOutputsEXT(meshlet.nVertices, meshlet.nPrimitives);
}

/*****************************************************************************************/